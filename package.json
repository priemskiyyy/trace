{
  "name": "trace-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "test:lint": "node scripts/verify-lint-rules.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check": "pnpm build && pnpm lint:typescript && pnpm lint:eslint && pnpm test:lint && pnpm lint:prettier && pnpm test:unit"
  },
  "devDependencies": {
    "@amplitude/analytics-browser": "2.45.10",
    "@amplitude/analytics-node": "1.5.73",
    "@amplitude/analytics-react-native": "1.10.0",
    "@eslint/js": "9.39.4",
    "@phosphor-icons/react": "2.1.10",
    "@plausible-analytics/tracker": "0.4.6",
    "@playwright/test": "1.63.0",
    "@priemskiyyy/trace": "workspace:*",
    "@react-native-firebase/analytics": "26.4.0",
    "@react-native-firebase/app": "26.4.0",
    "@rudderstack/analytics-js": "3.34.1",
    "@segment/analytics-next": "1.84.3",
    "@segment/analytics-node": "3.1.0",
    "@segment/analytics-react-native": "2.24.1",
    "@solidjs/testing-library": "0.8.10",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/gtag.js": "0.0.20",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@types/umami-browser": "2.18.1",
    "@vercel/analytics": "2.0.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.0",
    "eslint-plugin-vue": "10.11.0",
    "fast-check": "4.10.2",
    "fathom-client": "3.7.2",
    "firebase": "12.19.0",
    "jsdom": "27.4.0",
    "mixpanel": "0.24.0",
    "mixpanel-browser": "2.83.0",
    "mixpanel-react-native": "3.8.0",
    "posthog-js": "1.434.2",
    "posthog-node": "5.52.6",
    "posthog-react-native": "4.77.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "solid-js": "1.9.15",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "tsdown": "0.22.14",
