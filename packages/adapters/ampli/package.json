{
  "name": "@priemskiyyy/trace-ampli",
  "version": "0.1.0",
  "description": "Ampli destination for Trace: each event is one Ampli track call with its time and insert id, typed by your generated classes, over the Ampli wrapper you inject.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/trace.git",
    "directory": "packages/adapters/ampli"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/trace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project ampli"
  },
  "peerDependencies": {
    "@priemskiyyy/trace": ">=0.1.0 <0.2",
    "@amplitude/analytics-browser": ">=2.45.0 <3"
  },
  "peerDependenciesMeta": {
    "@amplitude/analytics-browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@priemskiyyy/trace": "workspace:*"
  },
  "keywords": [
    "ampli",
    "amplitude",
    "product-analytics",
    "tracking-plan",
    "browser",
    "typescript",
    "trace",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/trace/"
}
