{
  "name": "@priemskiyyy/trace-console",
  "version": "0.1.0",
  "description": "Console destination for Trace: each event and identity call is one [trace] line with the frozen value it describes, over the global console or a writer you inject.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/trace.git",
    "directory": "packages/adapters/console"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/trace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project console"
  },
  "peerDependencies": {
    "@priemskiyyy/trace": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/trace": "workspace:*"
  },
  "keywords": [
    "console",
    "logging",
    "development",
    "typescript",
    "trace",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/trace/"
}
