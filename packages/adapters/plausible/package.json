{
  "name": "@priemskiyyy/trace-plausible",
  "version": "0.1.0",
  "description": "Plausible destination for Trace: each event is one custom event with string props and no identifiers, over the Plausible tracker you inject.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/trace.git",
    "directory": "packages/adapters/plausible"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/trace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project plausible"
  },
  "peerDependencies": {
    "@priemskiyyy/trace": ">=0.1.0 <0.2",
    "@plausible-analytics/tracker": ">=0.4.0 <1"
  },
  "peerDependenciesMeta": {
    "@plausible-analytics/tracker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@priemskiyyy/trace": "workspace:*"
  },
  "keywords": [
    "plausible",
    "web-analytics",
    "privacy",
    "browser",
    "typescript",
    "trace",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/trace/"
}
