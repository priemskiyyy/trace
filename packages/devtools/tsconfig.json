{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": {
      "src/*": ["./src/*"],
      "@priemskiyyy/trace-devtools": ["./src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "tsdown.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
