{
  "name": "@priemskiyyy/trace-solid",
  "version": "0.1.0",
  "description": "Solid bindings for Trace: a provider, and primitives for the Trace, its status, a destination's status and consent that observe without starting or tracking anything.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/trace.git",
    "directory": "packages/solid"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/trace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project solid --project solid-ssr --project solid-hydration"
  },
  "peerDependencies": {
    "@priemskiyyy/trace": ">=0.1.0 <0.2",
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@priemskiyyy/trace": "workspace:*"
  },
  "keywords": [
    "solid",
    "solidjs",
    "primitives",
    "product-analytics",
    "typescript",
    "trace"
  ],
  "homepage": "https://priemskiyyy.github.io/trace/"
}
