{
  "name": "@priemskiyyy/trace-svelte",
  "version": "0.1.0",
  "description": "Svelte bindings for Trace: a provider, and utilities for the Trace, its status, a destination's status and consent that observe without starting or tracking anything.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/trace.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/trace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.fixture.*",
    "!dist/**/*.contracts.*",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "lint:typescript": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project svelte --project svelte-ssr"
  },
  "peerDependencies": {
    "@priemskiyyy/trace": ">=0.1.0 <0.2",
    "svelte": ">=5.7.0 <6"
  },
  "devDependencies": {
    "@priemskiyyy/trace": "workspace:*"
  },
  "keywords": [
    "svelte",
    "product-analytics",
    "typescript",
    "trace"
  ],
  "homepage": "https://priemskiyyy.github.io/trace/"
}
